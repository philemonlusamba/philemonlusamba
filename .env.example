# Copier en .env puis renseigner la cle du provider utilise.
# Aucune de ces valeurs n'est necessaire pour le provider mock (defaut).

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Generator Language API (Gemini) : GEMINI_API_KEY ou GOOGLE_API_KEY
# GEMINI_API_KEY=AIza...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Modele par defaut si --provider / --models est utilise sans ":modele"
# AGENTS_MODEL=gpt-4o-mini

# ---------------------------------------------------------------- Nexus HLP.AI
# Aucune variable n'est necessaire pour le mode Nexus Demo.

# Passerelle Replicate (model_ref owner/model dans l'interface)
# REPLICATE_API_TOKEN=r8_...
# NEXUS_REPLICATE_MODEL=owner/model
# REPLICATE_BASE_URL=https://api.replicate.com/v1

# Passerelle fal.ai (model_ref fal-ai/nom-du-modele dans l'interface)
# FAL_KEY=...
# NEXUS_FAL_MODEL=fal-ai/nom-du-modele
# FAL_QUEUE_URL=https://queue.fal.run

# Webhook normalise pour une API privee, Sora/Veo/Runway ou ComfyUI
# NEXUS_WEBHOOK_URL=https://votre-api.example/generate
# NEXUS_WEBHOOK_TOKEN=...

# Port de l'application web (defaut Nexus : 8001)
# PORT=8001

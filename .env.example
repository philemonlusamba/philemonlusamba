# Copier en .env puis renseigner la cle du provider utilise.
# Aucune de ces valeurs n'est necessaire pour le provider mock (defaut).

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Generator Language API (Gemini) : GEMINI_API_KEY ou GOOGLE_API_KEY
# GEMINI_API_KEY=AIza...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Modele par defaut si --provider / --models est utilise sans ":modele"
# AGENTS_MODEL=gpt-4o-mini
